/*
 * DAPLink Zephyr - Black F407VE Board Overlay
 *
 * Adds: HID debug, CDC ACM UART bridge, MSC (VFS drag-and-drop)
 * Board DTS already enables USB OTG FS (zephyr_udc0).
 */

/ {
	/* SWD debug probe GPIO pins */
	daplink: daplink {
		compatible = "daplink,gpio";

		swclk-gpios = <&gpiob 13 0>;
		swdio-gpios = <&gpiob 14 0>;
		nreset-gpios = <&gpiob 0 (GPIO_OPEN_DRAIN | GPIO_ACTIVE_LOW)>;
		/* JTAG: TCK=PB13, TMS=PB14 (reuse SWCLK/SWDIO) */
		tdi-gpios = <&gpiob 15 0>;
		tdo-gpios = <&gpiob 12 0>;
	};

	/* HID device for CMSIS-DAP */
	hid_dev_0: hid_dev_0 {
		compatible = "zephyr,hid-device";
		in-report-size = <64>;
		in-polling-period-us = <1000>;
		out-report-size = <64>;
		out-polling-period-us = <1000>;
	};

	/* UART bridge: CDC ACM <-> target USART2 (PA2/PA3) */
	uart_bridge0 {
		compatible = "zephyr,uart-bridge";
		peers = <&cdc_acm_uart0 &usart2>;
	};

	/*
	 * Dummy RAM disk: ensures drivers__disk library has sources.
	 * The actual MSC backend is the custom VFS driver (vfs_disk.c).
	 * Uses disk-name "RAMDISK" (not "DAPLINK") to avoid conflicts.
	 */
	ramdisk_dummy {
		compatible = "zephyr,ram-disk";
		disk-name = "RAMDISK";
		sector-size = <512>;
		sector-count = <1>;
	};
};

/* CDC ACM UART instance (child of USB controller) */
&usbotg_fs {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
